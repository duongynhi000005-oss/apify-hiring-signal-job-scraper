{
  "actorSpecification": 1,
  "name": "hiring-signal-job-scraper",
  "title": "ATS Career Page Job Scraper & B2B Hiring Intent Signal Engine",
  "description": "Extracts structured open roles, departments, remote status, salary ranges, ATS platform (Greenhouse, Lever, Ashby, Workable, Workday), required tech stack signals, and a 0-100 B2B Hiring Velocity Score from company career pages.",
  "version": "1.0",
  "meta": {
    "templateId": "js-start"
  },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "ATS Career Page Job Scraper & B2B Hiring Intent Signal Engine Output",
    "description": "Extracts structured open roles, departments, remote status, salary ranges, ATS platform (Greenhouse, Lever, Ashby, Workable, Workday), required tech stack signals, and a 0-100 B2B Hiring Velocity Score from company career pages.",
    "type": "object",
    "properties": {
      "results": {
        "type": "string",
        "title": "Enriched Dataset Items",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "ATS Career Page Job Scraper & B2B Hiring Intent Signal Engine Dataset",
      "description": "Extracts structured open roles, departments, remote status, salary ranges, ATS platform (Greenhouse, Lever, Ashby, Workable, Workday), required tech stack signals, and a 0-100 B2B Hiring Velocity Score from company career pages.",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "url",
              "atsPlatform",
              "hiringSignalTier",
              "openRolesCount",
              "detectedTechStackSignals"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "Career Page URL",
                "format": "text"
              },
              "atsPlatform": {
                "label": "ATS Platform",
                "format": "text"
              },
              "hiringSignalTier": {
                "label": "Buying Intent Tier",
                "format": "text"
              },
              "openRolesCount": {
                "label": "Open Roles",
                "format": "text"
              },
              "detectedTechStackSignals": {
                "label": "Tech Stack Signals",
                "format": "text"
              }
            }
          }
        }
      },
      "fields": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Career Page URL",
            "description": "Career Page URL"
          },
          "atsPlatform": {
            "type": "string",
            "title": "ATS Platform",
            "description": "ATS Platform"
          },
          "hiringSignalTier": {
            "type": "string",
            "title": "Buying Intent Tier",
            "description": "Buying Intent Tier"
          },
          "openRolesCount": {
            "type": "integer",
            "title": "Open Roles",
            "description": "Open Roles"
          },
          "detectedTechStackSignals": {
            "type": "array",
            "title": "Tech Stack Signals",
            "description": "Tech Stack Signals"
          }
