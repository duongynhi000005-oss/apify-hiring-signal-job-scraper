{
  "actorSpecification": 1,
  "name": "b2b-hiring-signal-job-scraper",
  "title": "B2B Hiring Signal & ATS Job Posting Scraper (PPE)",
  "description": "Extracts structured job postings, compensation bands, remote policy, tech stack keywords, and B2B hiring velocity signals from Greenhouse, Lever, Ashby, Workable, and company career pages (Schema.org/JobPosting).",
  "version": "1.0",
  "meta": {
    "templateId": "js-crawlee-cheerio"
  },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "url"
          },
          "title": {
            "type": "string",
            "title": "title"
          },
          "company": {
            "type": "string",
            "title": "company"
          },
          "location": {
            "type": "string",
            "title": "location"
          },
          "employmentType": {
            "type": "string",
            "title": "employmentType"
          },
          "datePosted": {
            "type": "string",
            "title": "datePosted"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Extracted Job Postings & Hiring Signals",
          "transformation": {
            "fields": [
              "url",
              "title",
              "company",
              "location",
              "employmentType",
              "datePosted"
            ]
          },
          "display": {
            "component": "table",
            "properties": {}
          }
        }
      }
    }
  },
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "Extracted Job Postings & Hiring Signals Output",
    "properties": {
      "dataset": {
        "type": "string",
        "title": "Extracted Job Postings & Hiring Signals",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  }
}
